# Copie para .env.local para desenvolvimento. Na Vercel, configure em
# Settings > Environment Variables. Nenhuma das duas é segredo — ambas são
# NEXT_PUBLIC_ e ficam visíveis no navegador, como deve ser.

# Número do WhatsApp em formato internacional, só dígitos (país + DDD + número).
# Alimenta todos os CTAs de WhatsApp e o envio do formulário.
# O código já usa este valor como padrão, então o site funciona mesmo sem a var.
NEXT_PUBLIC_WHATSAPP=5535984487206

# URL canônica do site. Usada em metadata, Open Graph, sitemap e robots.
# Sem ela, a Vercel injeta a URL do projeto automaticamente
# (VERCEL_PROJECT_PRODUCTION_URL). Configure quando tiver domínio próprio.
# NEXT_PUBLIC_SITE_URL=https://seudominio.com.br
